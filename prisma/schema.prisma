generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum QrCodeStatus {
  CREATED
  ASSIGNED
  USED
  DISABLED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Event {
  id              String           @id @default(cuid())
  name            String
  eventDate       DateTime
  location        String
  status          EventStatus      @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  vrRecords       VrRecord[]
  qrCodes         QrCode[]
  qrRegistrations QrRegistration[]
  notifications   Notification[]

  @@index([status, eventDate])
  @@index([eventDate])
}

model School {
  id              String           @id @default(cuid())
  name            String
  normalizedName  String           @unique
  status          SchoolStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  vrRecords       VrRecord[]
  qrRegistrations QrRegistration[]

  @@index([status])
  @@index([name])
}

model User {
  id                    String           @id @default(cuid())
  authUserId            String           @unique
  email                 String           @unique
  fullName              String
  role                  UserRole         @default(STAFF)
  status                UserStatus       @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdVrRecords      VrRecord[]       @relation("VrRecordCreatedBy")
  studentMatches        StudentMatch[]   @relation("StudentMatchMatchedBy")
  attendedRegistrations QrRegistration[] @relation("QrRegistrationAttendedBy")
  enrolledRegistrations QrRegistration[] @relation("QrRegistrationEnrolledBy")
  auditLogs             AuditLog[]       @relation("AuditLogActor")
  notifications         Notification[]
}

model VrRecord {
  id               String                    @id @default(cuid())
  firstName        String
  lastName         String
  school           String
  schoolId         String?
  eventId          String
  phone            String?
  createdByUserId  String
  assignedQrCodeId String?                   @unique
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  createdByUser    User                      @relation("VrRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedQrCode   QrCode?                   @relation("QrCodeAssignedToVrRecord", fields: [assignedQrCodeId], references: [id], onDelete: SetNull)
  studentMatch     StudentMatch?
  academyLink      AcademyStudentLink?
  academySnapshot  AcademyPaymentSnapshot?
  academyLedger    AcademyCommissionLedger[]
  schoolRelation   School?                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  event            Event                     @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([firstName])
  @@index([lastName])
  @@index([school])
  @@index([schoolId])
  @@index([eventId, createdAt])
  @@index([createdByUserId])
  @@index([createdAt])
}

model QrCode {
  id               String          @id @default(cuid())
  serialNumber     String          @unique
  tokenHash        String          @unique
  eventId          String
  status           QrCodeStatus    @default(CREATED)
  assignedAt       DateTime?
  usedAt           DateTime?
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  assignedVrRecord VrRecord?       @relation("QrCodeAssignedToVrRecord")
  qrRegistration   QrRegistration?
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([eventId, status])
  @@index([createdAt])
  @@index([archivedAt])
}

model QrRegistration {
  id               String               @id @default(cuid())
  qrCodeId         String               @unique
  eventId          String
  firstName        String
  lastName         String
  guardianName     String
  phone            String
  school           String
  schoolId         String?
  registeredAt     DateTime             @default(now())
  attendedEvent    Boolean              @default(false)
  attendedAt       DateTime?
  attendedByUserId String?
  enrolledCourse   Boolean              @default(false)
  enrolledAt       DateTime?
  enrolledByUserId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  qrCode           QrCode               @relation(fields: [qrCodeId], references: [id], onDelete: Restrict)
  attendedByUser   User?                @relation("QrRegistrationAttendedBy", fields: [attendedByUserId], references: [id], onDelete: SetNull)
  enrolledByUser   User?                @relation("QrRegistrationEnrolledBy", fields: [enrolledByUserId], references: [id], onDelete: SetNull)
  studentMatch     StudentMatch?
  academyLinks     AcademyStudentLink[]
  schoolRelation   School?              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  event            Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([firstName])
  @@index([lastName])
  @@index([school])
  @@index([schoolId])
  @@index([eventId, registeredAt])
  @@index([phone])
  @@index([registeredAt])
  @@index([attendedEvent])
  @@index([enrolledCourse])
}

model StudentMatch {
  id               String         @id @default(cuid())
  vrRecordId       String         @unique
  qrRegistrationId String         @unique
  matchedByUserId  String
  matchedAt        DateTime       @default(now())
  vrRecord         VrRecord       @relation(fields: [vrRecordId], references: [id], onDelete: Cascade)
  qrRegistration   QrRegistration @relation(fields: [qrRegistrationId], references: [id], onDelete: Cascade)
  matchedByUser    User           @relation("StudentMatchMatchedBy", fields: [matchedByUserId], references: [id], onDelete: Restrict)

  @@index([matchedByUserId])
  @@index([matchedAt])
}

enum AcademyMatchStatus {
  MATCHED
  NOT_FOUND
  AMBIGUOUS
}

enum AcademySyncRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum AcademySyncRunSource {
  CRON
  MANUAL
}

model AcademyStudentLink {
  id               String             @id @default(cuid())
  vrRecordId       String             @unique
  qrRegistrationId String
  academyStudentId String?
  status           AcademyMatchStatus
  matchedAt        DateTime?
  lastCheckedAt    DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  vrRecord         VrRecord           @relation(fields: [vrRecordId], references: [id], onDelete: Restrict)
  qrRegistration   QrRegistration     @relation(fields: [qrRegistrationId], references: [id], onDelete: Restrict)

  @@index([status, lastCheckedAt])
  @@index([academyStudentId])
}

model AcademyPaymentSnapshot {
  id                     String   @id @default(cuid())
  vrRecordId             String   @unique
  academyStudentId       String
  lastObservedPaidAmount Decimal  @db.Decimal(14, 2)
  currency               String   @db.Char(3)
  version                Int      @default(0)
  lastSyncedAt           DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  vrRecord               VrRecord @relation(fields: [vrRecordId], references: [id], onDelete: Restrict)

  @@index([academyStudentId])
}

model AcademyCommissionLedger {
  id                    String         @id @default(cuid())
  vrRecordId            String
  academyStudentId      String
  academyPaymentDelta   Decimal        @db.Decimal(14, 2)
  commissionRate        Decimal        @db.Decimal(7, 4)
  commissionAmount      Decimal        @db.Decimal(14, 2)
  academyTotalPaidAfter Decimal        @db.Decimal(14, 2)
  currency              String         @db.Char(3)
  snapshotVersion       Int
  syncRunId             String
  createdAt             DateTime       @default(now())
  vrRecord              VrRecord       @relation(fields: [vrRecordId], references: [id], onDelete: Restrict)
  syncRun               AcademySyncRun @relation(fields: [syncRunId], references: [id], onDelete: Restrict)

  @@unique([vrRecordId, snapshotVersion])
  @@index([syncRunId])
  @@index([academyStudentId, createdAt])
}

model AcademySyncRun {
  id                        String                    @id @default(cuid())
  startedAt                 DateTime                  @default(now())
  finishedAt                DateTime?
  status                    AcademySyncRunStatus      @default(RUNNING)
  source                    AcademySyncRunSource      @default(CRON)
  candidateCount            Int                       @default(0)
  matchedCount              Int                       @default(0)
  notFoundCount             Int                       @default(0)
  ambiguousCount            Int                       @default(0)
  commissionAdjustmentCount Int                       @default(0)
  errorCount                Int                       @default(0)
  ledgers                   AcademyCommissionLedger[]

  @@index([startedAt])
  @@index([status, startedAt])
}

model AuditLog {
  id                String   @id @default(cuid())
  actorUserId       String?
  actorType         String   @default("USER")
  action            String
  entityType        String
  entityId          String
  relatedEntityType String?
  relatedEntityId   String?
  reason            String?
  beforeData        Json?
  afterData         Json?
  metadata          Json?
  correlationId     String?
  createdAt         DateTime @default(now())
  actorUser         User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  eventId           String?
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  event             Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, eventId, createdAt])
  @@index([type, createdAt])
}
